# =============================================================================
# 企业私有化网盘 - 环境变量模板
# 用法: cp .env.example .env && 编辑 .env（所有密码/密钥必须替换为强随机值）
# 禁止将 .env 提交到代码仓库
# =============================================================================

# ---------- 基础 ----------
TZ=Asia/Shanghai
# Web 对外访问端口（docker compose 暴露）
WEB_PORT=8080
VERSION=1.0.0

# ---------- PostgreSQL ----------
POSTGRES_DB=netdisk
POSTGRES_USER=netdisk
POSTGRES_PASSWORD=please-change-postgres-password
# 数据库数据卷挂载点（容器内，一般无需修改）
PGDATA=/var/lib/postgresql/data

# ---------- MinIO ----------
# MinIO root 凭据：仅存在于后端环境变量，前端永远接触不到
MINIO_ROOT_USER=netdisk-root
MINIO_ROOT_PASSWORD=please-change-minio-password
# 数据桶名（业务层封装，前端不可见）
MINIO_BUCKET=netdisk-data
# MinIO 对外端口（S3 API / Console）
MINIO_EXTERNAL_PORT=9000
MINIO_CONSOLE_PORT=9001
# 浏览器可访问的 MinIO 公网/内网地址（用于签名 URL 的 Host）
# 必填：填写部署服务器在局域网内的 IP 或主机名，如 192.168.1.10
MINIO_PUBLIC_ENDPOINT=192.168.1.10
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

# ---------- 后端服务 ----------
SERVER_PORT=3000
# 本地开发用数据库连接串（docker compose 会自动拼接，无需修改）
DATABASE_URL=postgres://netdisk:please-change-postgres-password@127.0.0.1:5432/netdisk
# JWT 签名密钥：openssl rand -base64 48 生成
JWT_ACCESS_SECRET=please-change-access-secret
JWT_REFRESH_SECRET=please-change-refresh-secret
# Cookie 签名密钥（CSRF/会话）
COOKIE_SECRET=please-change-cookie-secret
# Access Token 有效期
JWT_ACCESS_TTL=30m
# Refresh Token 有效期（即"记住登录"时长）
JWT_REFRESH_TTL=30d
# 签名 URL 有效期（秒）
PRESIGN_EXPIRY=3600
# 分片大小（字节，MinIO 要求 >= 5MB，建议 16MB）
PART_SIZE=16777216
# 小于该大小的文件走单请求直传（字节）
SMALL_FILE_THRESHOLD=8388608
# 服务端 SHA-256 校验阈值：小于该值的文件上传后服务端重算哈希（字节）
VERIFY_SHA256_THRESHOLD=67108864
# 去重命中等待/在线校验上限：小/中文件可等待后台池就绪；超大文件不等待，池就绪后自动秒传（字节）
DEDUP_INLINE_MAX=1073741824
# 去重池 GC 保留期（天）：零引用池（删除后保留作秒传缓存）超过该天数后由每日任务清理
POOL_GC_DAYS=30
# B3SEG 段缓存内存预算（MB）：段数据缓存 LRU 容量（0=仅段哈希缓存，段哈希本身仅 32B/段、内存极小）
HASH_CACHE_MB=512
# 去重不限大小：任何大小的文件命中去重池均为零拷贝元数据秒传（无需配置）
# 回收站保留天数，超期自动彻底删除
TRASH_RETENTION_DAYS=30
# 审计日志保留天数，超期自动清理
AUDIT_RETENTION_DAYS=365
# 配额重算定时任务（cron，UTC）
QUOTA_RECOMPUTE_CRON=0 3 * * *
# 开发模式 CORS 白名单（逗号分隔；生产同源反代无需配置）
CORS_ORIGIN=http://localhost:5173
# 是否信任反向代理传递的 X-Forwarded-For（nginx 反代时置 true）
TRUST_PROXY=false

# ---------- 初始管理员（首次启动自动创建，幂等） ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-admin-password
ADMIN_DISPLAY_NAME=系统管理员

# ---------- LDAP / AD 对接（占位，默认关闭） ----------
LDAP_ENABLED=false
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName=%s))
