# 本地开发环境变量模板（复制为 server/.env 使用）
# 生产环境由 docker compose 注入，无需此文件
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://netdisk:please-change-postgres-password@127.0.0.1:5432/netdisk

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
COOKIE_SECRET=dev-cookie-secret-change-me

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
# 本地开发默认与内部端点一致
MINIO_PUBLIC_ENDPOINT=127.0.0.1
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=netdisk-root
MINIO_SECRET_KEY=please-change-minio-password
MINIO_BUCKET=netdisk-data

CORS_ORIGIN=http://localhost:5173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_DISPLAY_NAME=系统管理员

LDAP_ENABLED=false
